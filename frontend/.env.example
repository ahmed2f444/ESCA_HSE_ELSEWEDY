# ==============================================================================
# ESCA HSE WEB DASHBOARD — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env and adjust as needed.

# Set VITE_USE_MOCK=false to connect to live Spring Boot (:8080) and AI Agent (:8000)
# Set VITE_USE_MOCK=true to run in standalone mock/demo mode without backend
VITE_USE_MOCK=false

# API and Agent Proxy Base URLs
VITE_API_BASE_URL=/api
VITE_AGENT_BASE_URL=/agent
