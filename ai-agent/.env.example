# ==============================================================================
# ESCA HSE AI AGENT — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env and adjust your credentials.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL Single Source of Truth)
# ------------------------------------------------------------------------------
DB_HOST=zephyr.proxy.rlwy.net
DB_PORT=17885
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=railway
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ------------------------------------------------------------------------------
# 2. ONLINE AI ASSISTANT (Groq Cloud API - Fast Inference)
# ------------------------------------------------------------------------------
# Get your free Groq API key in 1 min at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Supported Online Groq Models (Select one as primary):
# - openai/gpt-oss-120b       (Recommended default - High quality reasoning & tool-calling)
# - openai/gpt-oss-20b        (Fast lightweight fallback)
# - llama-3.3-70b-versatile   (State of the art Meta LLaMA 3.3 70B)
# - llama-3.1-8b-instant      (Ultra-fast low-latency 8B model)
# - qwen/qwen3.6-27b          (Multilingual Arabic/English technical reasoning)
# - allam-2-7b                (Specialized Arabic foundation model)
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 3. LOCAL AI ASSISTANT (Ollama Local Instance - Offline / Private)
# ------------------------------------------------------------------------------
# Run Ollama locally (https://ollama.com). No API key required.
LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# Supported Local Ollama Models:
# - esca-agent-local   (Custom Modelfile built for ESCA HSE system)
# - qwen2.5-coder:7b   (Recommended: `ollama pull qwen2.5-coder:7b` - Great SQL & JSON parsing)
# - llama3.2:3b        (Lightweight: `ollama pull llama3.2:3b` - Fast on standard laptops)
# - mistral:7b         (General purpose: `ollama pull mistral:7b`)
LOCAL_LLM_MODEL=esca-agent-local

# ------------------------------------------------------------------------------
# 4. SPRING BOOT REST API INTEGRATION (For Mutations & Audited Actions)
# ------------------------------------------------------------------------------
SPRING_API_BASE_URL=http://localhost:8080
AUTOMATION_CLIENT_ID=esca-hse-automation
AUTOMATION_CLIENT_SECRET=local-automation-secret-change-me

# Live in-app notifications:
# The agent detects candidates read-only, then Spring validates each event and
# creates an idempotent notification plus an audit record.
AUTOMATION_DELIVERY_MODE=spring
AUTOMATION_LIVE_ENABLED=true
ENABLE_SCHEDULER=true
