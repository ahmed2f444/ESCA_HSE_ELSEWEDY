# ==============================================================================
# ESCA HSE MANAGEMENT SYSTEM — BACKEND CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env or pass these environment variables when starting the backend.

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL)
# Default connects to the Railway cloud MySQL instance:
DB_HOST=zephyr.proxy.rlwy.net
DB_PORT=17885
DB_NAME=railway
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Security & JWT Configuration
# Set APP_SECURITY_ENABLED=true to enforce strict role-based JWT authentication
APP_SECURITY_ENABLED=false
APP_JWT_SECRET=local-development-secret-change-before-deployment-at-least-32-chars
APP_TOKEN_TTL_SECONDS=28800
APP_DEMO_USERS_ENABLED=true
APP_DEMO_DATA_ENABLED=false

# Automation Service Account (Python AI Agent Integration)
AUTOMATION_CLIENT_ID=esca-hse-automation
AUTOMATION_CLIENT_SECRET=local-automation-secret-change-me
AUTOMATION_TOKEN_TTL_SECONDS=900

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:3000,http://localhost:3100,http://127.0.0.1:5180
